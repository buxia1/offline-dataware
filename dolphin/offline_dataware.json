    "name" : "dwd_delete",
    "version" : 4,
    "description" : "",
    "projectCode" : 23142056525568,
    "userId" : 1,
    "taskType" : "SHELL",
    "taskParams" : {"localParams":[],"rawScript":"D=${system.biz.date}\r\nDF=\"${D:0:4}-${D:4:2}-${D:6:2}\"\r\ndocker exec starrocks mysql -P9030 -h127.0.0.1 -uroot -e \"\r\nINSERT OVERWRITE dwd.dwd_order_detail PARTITION (p${D})\r\nSELECT order_id, dt, user_id, product_id, amount, order_time, status\r\nFROM (\r\n    SELECT order_id, dt, user_id, product_id,\r\n           ABS(amount) AS amount, order_time, status,\r\n           ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY ABS(amount) DESC) AS rn\r\n    FROM ods.ods_order\r\n    WHERE user_id IS NOT NULL AND dt = '${DF}'\r\n) t\r\nWHERE rn = 1;\r\n\"","resourceList":[]},
